---
interface Props { current?: 'home' | 'roadmap' | 'about'; }
const { current = 'home' } = Astro.props;
const links = [
  { href: '/docs/', text: 'Documentation', id: 'docs' },
  { href: '/roadmap/', text: 'Roadmap', id: 'roadmap' },
  { href: '/about/', text: 'About', id: 'about' },
];
---
<header class="site-header">
  <div class="site-container header-inner">
    <a class="brand" href="/" aria-label="Atomic Flow home">
      <img src="/favicon.svg" width="36" height="36" alt="" />
      <span>atomic <span class="brand-light">flow</span><span class="brand-dot">.</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {links.map((link) => <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.text}</a>)}
    </nav>
    <a class="header-github" href="https://github.com/atomic-flow-dev" target="_blank" rel="noopener noreferrer">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19" fill="currentColor"><path d="M12 .9A11.1 11.1 0 0 0 .9 12c0 4.9 3.2 9.1 7.6 10.5.55.1.75-.24.75-.53v-2.1c-3.1.68-3.76-1.32-3.76-1.32-.5-1.3-1.24-1.65-1.24-1.65-1-.69.08-.67.08-.67 1.12.08 1.7 1.15 1.7 1.15 1 1.7 2.6 1.2 3.23.92.1-.72.4-1.2.73-1.48-2.48-.28-5.1-1.24-5.1-5.49 0-1.2.43-2.2 1.14-2.98-.12-.28-.5-1.4.1-2.92 0 0 .93-.3 3.05 1.14a10.6 10.6 0 0 1 5.54 0c2.12-1.44 3.04-1.14 3.04-1.14.6 1.51.23 2.64.11 2.92.72.78 1.14 1.78 1.14 2.98 0 4.27-2.63 5.2-5.12 5.48.42.36.79 1.06.79 2.14v3.18c0 .3.2.64.76.53A11.1 11.1 0 0 0 23.1 12 11.1 11.1 0 0 0 12 .9Z"/></svg>
      <span>GitHub</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
    </a>
    <details class="mobile-nav">
      <summary aria-label="Toggle navigation">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </summary>
      <nav aria-label="Mobile navigation">
        {links.map((link) => <a href={link.href}>{link.text}</a>)}
        <a href="https://github.com/atomic-flow-dev" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </nav>
    </details>
  </div>
</header>
