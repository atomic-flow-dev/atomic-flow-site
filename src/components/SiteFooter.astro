---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-container footer-grid">
    <div class="footer-intro">
      <a class="brand" href="/" aria-label="Atomic Flow home">
        <img src="/favicon.svg" width="31" height="31" alt="" />
        <span>atomic<span class="brand-light">flow</span><span class="brand-dot">.</span></span>
      </a>
      <p>Reliable execution.<br />Predictable recovery.</p>
      <span class="footer-fine">An independent open-source initiative.</span>
    </div>
    <div class="footer-links">
      <div>
        <h2>Explore</h2>
        <a href="/docs/">Documentation</a>
        <a href="/roadmap/">Roadmap</a>
        <a href="/about/">About</a>
      </div>
      <div>
        <h2>Open source</h2>
        <a href="https://github.com/atomic-flow-dev/atomic-flow" target="_blank" rel="noopener noreferrer">Specification ↗</a>
        <a href="https://github.com/atomic-flow-dev/atomic-flow-ts" target="_blank" rel="noopener noreferrer">TypeScript ↗</a>
        <a href="https://github.com/atomic-flow-dev/atomic-flow-site" target="_blank" rel="noopener noreferrer">This website ↗</a>
      </div>
    </div>
  </div>
  <div class="site-container footer-bottom">
    <span>© {year} Atomic Flow contributors. Apache-2.0.</span>
    <span>Built with care. No unnecessary complexity.</span>
  </div>
</footer>
